load("@build_bazel_rules_apple//apple:apple.bzl", "local_provisioning_profile")
load("@build_bazel_rules_apple//apple:ios.bzl", "ios_application")
load("@rules_swift//swift:swift.bzl", "swift_library")
load("@rules_xcodeproj//xcodeproj:defs.bzl", "xcode_provisioning_profile")
load("@convo_signing//:signing.bzl", "IOS_PROFILE", "TEAM_ID")
load("//tools/signing:defs.bzl", "team_entitlements", "team_plist")

package(default_visibility = ["//visibility:public"])

# The native app: compiled Swift, real SwiftUI, no wasm on device. The client
# (ConvoApp) and UI (ConvoUI) run in-process; this target adds only the two
# native-provided dependencies the design allows — the native SwiftUI it's
# built against, and the networking stack that accepts inbound connections.
#
# Shared with the Mac app: the sources are the same, differing only where
# AppKit and UIKit differ (the share affordance, the QR image type, the @main
# guarded by os()). Exposed as a filegroup so there is one host, not two.
filegroup(
    name = "host_srcs",
    srcs = glob(["Sources/**/*.swift"]),
)

swift_library(
    name = "ios_lib",
    srcs = [":host_srcs"],
    module_name = "ConvoIOSHost",
    deps = [
        "@swiftpkg_communication//:Communication",
        "@swiftpkg_communication//:CommunicationWebRTC",
        "@swiftpkg_protocol//:ConvoCalling",
        "@swiftpkg_protocol//:ConvoNet",
        "@swiftpkg_shake_kit//:ShakeKit",
        "@swiftpkg_update_kit//:UpdateKit",
        "//libraries/convo_app",
        "//libraries/convo_gzip",
        "//libraries/convo_bundle",
        "//libraries/convo_services",
        "//libraries/convo_ui",
        "@isomer//swift_ffi/swift_ffi",
        "@isomer//apple/libraries/swift_ui",
        "@isomer//apple/libraries/swift_ui:isomer",
    ],
)

# Device signing is managed by Xcode (automatic provisioning) when building
# through the generated Convo.xcodeproj; simulator builds ignore this.
local_provisioning_profile(
    name = "local_profile",
    # The newest development profile on this Mac for com.LoganShire.P2PRC
    # itself, found by bundle id and kind (tools/signing/extension.bzl), with
    # its App Groups; the team from it or P2PRC_TEAM_ID, never the repo.
    profile_name = IOS_PROFILE or "iOS Team Provisioning Profile: com.LoganShire.P2PRC",
    tags = ["manual"],
    team_id = TEAM_ID,
)

# CI's device build (--config=ci_device: signed ad hoc), which CI's signer
# signs again with the bundle id's own profile (build_tools' `sign apple`):
# a placeholder profile, so no profile has to be on the machine that builds.
config_setting(
    name = "ci_device",
    constraint_values = ["@apple_support//constraints:device"],
    values = {"ios_signing_cert_name": "-"},
)

# The shared sign-in and UpdateKit's app group, in the team's own builds.
team_plist(name = "team_info")

team_entitlements(
    name = "device",
    bundle_id = "com.LoganShire.P2PRC",
)

xcode_provisioning_profile(
    name = "xcode_managed_profile",
    managed_by_xcode = True,
    provisioning_profile = ":local_profile",
    tags = ["manual"],
)

ios_application(
    name = "p2prc_ios",
    app_icons = ["//artwork/app_icon"],
    bundle_id = "com.LoganShire.P2PRC",
    # Device builds sign as the app itself (the profile supplies the team
    # prefix); a simulator build has no profile to take it from.
    entitlements = select({
        "@apple_support//constraints:device": ":device.entitlements",
        "//conditions:default": None,
    }),
    families = [
        "iphone",
        "ipad",
    ],
    infoplists = [
        "Info.plist",
        ":team_info.plist",
    ],
    minimum_os_version = "18.0",
    provisioning_profile = select({
        ":ci_device": "//tools/signing:ci_placeholder_profile",
        "@apple_support//constraints:device": ":xcode_managed_profile",
        "//conditions:default": None,
    }),
    resources = [
        # The site this phone hands to a browser that has nothing yet — the
        # same signed bundle GitHub Pages would otherwise serve. Carrying it
        # is what makes the app a bootstrapper rather than only a client.
        "//applications/p2prc_web",
    ],
    deps = [":ios_lib"],
)
