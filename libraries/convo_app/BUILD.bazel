load("@rules_swift//swift:swift.bzl", "swift_library")

package(default_visibility = ["//visibility:public"])

# The client's whole behaviour: identity, MLS group state, pairing, and the
# sync that merges two peers' histories. No I/O of its own — everything goes
# through the injected ConvoHost, which is what lets the same code run in the
# browser, in a native shell, and under test.
swift_library(
    name = "convo_app",
    srcs = glob(["Sources/**/*.swift"]),
    copts = [
        "-package-name",
        "convo_app",
    ],
    module_name = "ConvoApp",
    tags = ["manual"],
    deps = [
        "//libraries/convo_services",
        "@swiftpkg_protocol//:ConvoMLS",
        "@swiftpkg_protocol//:ConvoNet",
        "@swiftpkg_protocol//:ConvoSession",
    ] + select({
        "@platforms//os:wasi": ["@isomer//wasm/libraries/swift_ui"],
        "@platforms//os:android": [
            "@isomer//android/libraries/swift_ui",
            "@isomer//android/libraries/swift_ui:isomer",
        ],
        "//conditions:default": [
            "@isomer//apple/libraries/swift_ui",
            "@isomer//apple/libraries/swift_ui:isomer",
        ],
    }),
)
