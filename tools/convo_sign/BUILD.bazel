load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

# Signing tool for Convo app bundles. The private key lives outside the repo
# (default ~/.convo/signing-key); only the public key is checked in.
swift_binary(
    name = "convo_sign",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "ConvoSign",
    visibility = ["//visibility:public"],
    deps = ["//libraries/convo_bundle"],
)
