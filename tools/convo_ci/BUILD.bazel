load("@rules_swift//swift:swift_binary.bzl", "swift_binary")

# CI's own steps for Convo (.github/workflows/ci.yml): the release's version
# stamped where the apps show it, and the proof assembled from the pictures
# the verify job took. Built and run in CI's Linux container.
swift_binary(
    name = "convo_ci",
    srcs = glob(["Sources/**/*.swift"]),
    module_name = "ConvoCI",
    visibility = ["//visibility:public"],
    deps = [
        "@swift_crypto//:Crypto",
        "@swiftpkg_swift_argument_parser//:ArgumentParser",
    ],
)
